---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getScheduleWithStatus, getBlockProgress, formatMinutes } from '../../data/schedule';
import { getInProgressTasks, getTodoTasks, getDoneTasks, type NotionTask } from '../../lib/notion';
import { tagColorStyle } from '../../lib/task-colors';
import { SORT_OPTIONS, parseSortKey, sortTasks } from '../../lib/task-sort';

const blocks = getScheduleWithStatus();

let inProgressTasks: NotionTask[] = [];
let todoTasks: NotionTask[] = [];
let doneTasks: NotionTask[] = [];
let tasksError: string | null = null;
try {
  [inProgressTasks, todoTasks, doneTasks] = await Promise.all([
    getInProgressTasks(),
    getTodoTasks(),
    getDoneTasks(),
  ]);
} catch (err) {
  tasksError = err instanceof Error ? err.message : 'Erreur inconnue lors de la lecture Notion.';
}

const sortKey = parseSortKey(Astro.url.searchParams.get('sort'));
function sortUrl(key: string): string {
  return `${Astro.url.pathname}?sort=${key}`;
}

const sortedInProgress = sortTasks(inProgressTasks, sortKey);
const sortedTodo = sortTasks(todoTasks, sortKey);
---

<Base lang="fr" title="Routine" description="Où j'en suis maintenant." favicon="/favicon-routine.svg">
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="grainient-bg" id="grainientBg" aria-hidden="true"></div>

  <div class="routine-page">
    <button class="theme-toggle-btn" id="themeToggleBtn" title="Changer le theme">&#9790;</button>

    <h1>Où j'en <span>suis</span></h1>

    <div class="layout">
      <aside class="card schedule-card">
        <div class="schedule-header">
          <span class="schedule-title">Programme</span>
          <span class="schedule-clock" id="clock">--:--</span>
        </div>

        <div class="schedule-list" id="scheduleList">
          {
            blocks.map((block) => (
              <div
                class={`schedule-item ${block.status}`}
                style={block.status === 'current' ? `--block-progress:${getBlockProgress(block).toFixed(1)}%` : undefined}
              >
                <span class="schedule-time">{formatMinutes(block.start)}</span>
                <span class="schedule-label">{block.label}</span>
              </div>
            ))
          }
        </div>
      </aside>

      <main class="card tasks-card">
        {
          !tasksError && (
            <div class="sort-bar">
              <span class="sort-label">Trier par</span>
              <div class="sort-options">
                {SORT_OPTIONS.map((opt) => (
                  <a href={sortUrl(opt.key)} class:list={['sort-btn', opt.key === sortKey && 'active']}>
                    {opt.label}
                  </a>
                ))}
              </div>
            </div>
          )
        }
        {
          tasksError ? (
            <p class="tasks-error">Impossible de charger les tâches Notion : {tasksError}</p>
          ) : (
            <>
              <section class="tasks-section">
                <div class="tasks-header">
                  <span class="tasks-title">En cours</span>
                  <span class="tasks-count" id="inProgressCount">
                    {inProgressTasks.length}
                  </span>
                </div>
                <div id="inProgressContent">
                  {sortedInProgress.length === 0 ? (
                    <p class="tasks-empty">Aucune tâche en cours.</p>
                  ) : (
                    <ul class="task-list">
                      {sortedInProgress.map((task, i) => (
                        <li class="task-item in-progress" style={`--i:${i}`}>
                          <a href={task.url} target="_blank" rel="noopener noreferrer">
                            <span class="task-title">{task.title}</span>
                            {task.space && (
                              <span class="task-badge" style={tagColorStyle(task.spaceColor)}>
                                {task.space}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>

              <section class="tasks-section">
                <div class="tasks-header">
                  <span class="tasks-title">À faire</span>
                  <span class="tasks-count" id="todoCount">
                    {todoTasks.length}
                  </span>
                </div>
                <div id="todoContent">
                  {sortedTodo.length === 0 ? (
                    <p class="tasks-empty">Rien à faire pour l'instant.</p>
                  ) : (
                    <ul class="task-list">
                      {sortedTodo.map((task, i) => (
                        <li class="task-item todo" style={`--i:${i}`}>
                          <a href={task.url} target="_blank" rel="noopener noreferrer">
                            <span class="task-title">{task.title}</span>
                            {task.space && (
                              <span class="task-badge" style={tagColorStyle(task.spaceColor)}>
                                {task.space}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            </>
          )
        }
      </main>

      <aside class="card history-card">
        <div class="tasks-header">
          <span class="tasks-title">Historique</span>
          {!tasksError && (
            <span class="tasks-count" id="doneCount">
              {doneTasks.length}
            </span>
          )}
        </div>
        <div id="doneContent">
          {tasksError ? (
            <p class="tasks-empty">—</p>
          ) : doneTasks.length === 0 ? (
            <p class="tasks-empty">Aucune tâche terminée récemment.</p>
          ) : (
            <ul class="task-list">
              {doneTasks.map((task, i) => (
                <li class="task-item done" style={`--i:${i}`}>
                  <a href={task.url} target="_blank" rel="noopener noreferrer">
                    <span class="task-title">{task.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </aside>
    </div>

    {/* Gabarits clonés par le rafraîchissement client : rendus par Astro, ils
        portent l'attribut de scope des styles (contrairement à du HTML
        construit à la main en JS, qui sortirait sans aucun style). */}
    <template id="tplTaskList"><ul class="task-list" /></template>
    <template id="tplTasksEmpty"><p class="tasks-empty" /></template>
    <template id="tplTaskItem">
      <li class="task-item">
        <a target="_blank" rel="noopener noreferrer">
          <span class="task-title" />
          <span class="task-badge" />
        </a>
      </li>
    </template>
  </div>

  <script>
    import { getScheduleWithStatus, getBlockProgress } from '../../data/schedule';
    import { tagColorStyle } from '../../lib/task-colors';
    import { createGrainient } from '../../lib/grainient';
    import type { NotionTask } from '../../lib/notion';

    function pad(n: number) {
      return String(n).padStart(2, '0');
    }

    function tickClock() {
      const now = new Date();
      const el = document.getElementById('clock');
      if (el) el.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
    }
    tickClock();
    setInterval(tickClock, 1000);

    // ===== SCHEDULE: recompute past/current/upcoming purely from the wall
    // clock (the schedule is static), no network round-trip needed. =====
    function refreshSchedule() {
      const now = new Date();
      const blocks = getScheduleWithStatus(now);
      const items = document.querySelectorAll<HTMLElement>('#scheduleList .schedule-item');
      items.forEach((el, i) => {
        const block = blocks[i];
        if (!block) return;
        el.className = `schedule-item ${block.status}`;
        // Avancement dans le créneau : remplit le fil de la timeline et la
        // barre de progression du bloc courant.
        if (block.status === 'current') {
          el.style.setProperty('--block-progress', `${getBlockProgress(block, now).toFixed(1)}%`);
        } else {
          el.style.removeProperty('--block-progress');
        }
      });
    }
    refreshSchedule();
    setInterval(refreshSchedule, 30000);

    // ===== TASKS: light refresh via JSON instead of a full page reload. =====
    function cloneTemplate(id: string): HTMLElement | null {
      const tpl = document.getElementById(id) as HTMLTemplateElement | null;
      const node = tpl?.content.firstElementChild?.cloneNode(true);
      return (node as HTMLElement) ?? null;
    }

    function renderTaskList(
      container: HTMLElement,
      tasks: NotionTask[],
      variant: string,
      emptyText: string,
      compact = false,
    ) {
      container.replaceChildren();

      if (tasks.length === 0) {
        const empty = cloneTemplate('tplTasksEmpty');
        if (empty) {
          empty.textContent = emptyText;
          container.append(empty);
        }
        return;
      }

      const list = cloneTemplate('tplTaskList');
      if (!list) return;

      tasks.forEach((task, i) => {
        const item = cloneTemplate('tplTaskItem');
        if (!item) return;
        item.classList.add(variant);
        item.style.setProperty('--i', String(i));

        const link = item.querySelector('a');
        if (link) link.href = task.url;

        const title = item.querySelector('.task-title');
        if (title) title.textContent = task.title;

        const badge = item.querySelector('.task-badge');
        if (badge) {
          if (!compact && task.space) {
            badge.textContent = task.space;
            badge.setAttribute('style', tagColorStyle(task.spaceColor));
          } else {
            badge.remove();
          }
        }

        list.append(item);
      });

      container.append(list);
    }

    // Empreinte du contenu d'une section : tant qu'elle ne change pas, on ne
    // repeint rien — le rafraîchissement passe inaperçu au lieu de faire
    // clignoter les listes toutes les 60s.
    const lastSignatures: Record<string, string> = {};

    function updateSection(
      contentId: string,
      countId: string,
      tasks: NotionTask[],
      variant: string,
      emptyText: string,
      compact = false,
    ) {
      const content = document.getElementById(contentId);
      const count = document.getElementById(countId);
      if (count) count.textContent = String(tasks.length);
      if (!content) return;

      const signature = JSON.stringify(tasks.map((t) => [t.id, t.title, compact ? null : t.space]));
      if (lastSignatures[contentId] === signature) return;
      lastSignatures[contentId] = signature;
      renderTaskList(content, tasks, variant, emptyText, compact);
    }

    async function refreshTasks() {
      try {
        const res = await fetch(`/api/routine-tasks.json${location.search}`);
        const data = await res.json();
        if (data.error) return; // keep last known good state

        updateSection('inProgressContent', 'inProgressCount', data.inProgress, 'in-progress', 'Aucune tâche en cours.');
        updateSection('todoContent', 'todoCount', data.todo, 'todo', "Rien à faire pour l'instant.");
        updateSection('doneContent', 'doneCount', data.done, 'done', 'Aucune tâche terminée récemment.', true);
      } catch {
        // Réseau indisponible : on garde le dernier état connu plutôt que de casser l'affichage.
      }
    }
    setInterval(refreshTasks, 60000);

    // ===== BACKGROUND: dégradé grainé animé.
    // Réglages d'origine du composant (reactbits.dev) : seules les couleurs
    // sont adaptées à la palette du dashboard.
    const BG_BASE = {
      timeSpeed: 0.25,
      colorBalance: 0.0,
      warpStrength: 1.0,
      warpFrequency: 5.0,
      warpSpeed: 2.0,
      warpAmplitude: 50.0,
      blendAngle: 0.0,
      blendSoftness: 0.05,
      rotationAmount: 500.0,
      noiseScale: 2.0,
      grainAmount: 0.1,
      grainScale: 2.0,
      grainAnimated: false,
      contrast: 1.5,
      gamma: 1.0,
      saturation: 1.0,
      centerX: 0.0,
      centerY: 0.0,
      zoom: 0.9,
    };
    // Trois teintes distinctes de la palette, sans blanc : le violet éclairci
    // garde le champ assez clair pour que les cartes blanches ressortent, le
    // cyan sert de base sourde pour éviter la bouillie mauve.
    const BG_LIGHT = {
      color1: '#d3b3e2', // violet éclairci
      color2: '#8b80f9', // indigo
      color3: '#628f93', // cyan
    };
    // De nuit, on descend d'un cran en luminosité sur les mêmes teintes.
    const BG_DARK = {
      color1: '#6f66d6', // indigo assombri
      color2: '#a67fbd', // violet assombri
      color3: '#151d3d', // raisin profond
    };

    const grainient = (() => {
      const el = document.getElementById('grainientBg');
      return el ? createGrainient(el, { ...BG_BASE, ...BG_LIGHT }) : null;
    })();

    function applyBackgroundPalette(theme: 'light' | 'dark') {
      grainient?.update(theme === 'dark' ? BG_DARK : BG_LIGHT);
    }

    // ===== THEME (auto by time-of-day / light / dark) =====
    const THEME_DAY_START = 7;
    const THEME_NIGHT_START = 20;

    function getAutoTheme(): 'light' | 'dark' {
      const h = new Date().getHours();
      return h >= THEME_DAY_START && h < THEME_NIGHT_START ? 'light' : 'dark';
    }
    function getThemeMode(): 'auto' | 'light' | 'dark' {
      return (localStorage.getItem('routine-theme') as 'light' | 'dark' | null) ?? 'auto';
    }
    function getEffectiveTheme(mode: 'auto' | 'light' | 'dark') {
      return mode === 'auto' ? getAutoTheme() : mode;
    }
    function updateThemeButton(mode: 'auto' | 'light' | 'dark') {
      const btn = document.getElementById('themeToggleBtn');
      if (!btn) return;
      const icons = { auto: '&#9681;', light: '&#9728;', dark: '&#9790;' };
      const titles = { auto: "Mode auto (suivant l'heure)", light: 'Mode clair', dark: 'Mode sombre' };
      btn.innerHTML = icons[mode];
      btn.title = titles[mode];
      btn.classList.toggle('theme-auto', mode === 'auto');
    }
    function applyTheme(mode: 'auto' | 'light' | 'dark') {
      const effective = getEffectiveTheme(mode);
      document.documentElement.setAttribute('data-theme', effective);
      updateThemeButton(mode);
      applyBackgroundPalette(effective);
    }

    document.getElementById('themeToggleBtn')?.addEventListener('click', () => {
      const current = getThemeMode();
      const next = { auto: 'light', light: 'dark', dark: 'auto' }[current] as 'auto' | 'light' | 'dark';
      if (next === 'auto') localStorage.removeItem('routine-theme');
      else localStorage.setItem('routine-theme', next);
      applyTheme(next);
    });

    setInterval(() => {
      if (getThemeMode() === 'auto') {
        const desired = getAutoTheme();
        if (desired !== document.documentElement.getAttribute('data-theme')) applyTheme('auto');
      }
    }, 60000);

    applyTheme(getThemeMode());
  </script>

  <style>
    .routine-page {
      --raisin: #1e2952;
      --indigo: #8b80f9;
      --violet: #c9a0dc;
      --sunglow: #fcca46;
      --cyan: #628f93;
      --isabelline: #eee7e8;
      --cream: #f4f0ec;
      --white: #ffffff;
      --foreground: #1e1e24;
      --polaroid-light: #f8f4f0;
      --polaroid-mid: #ede7e0;
      --past-line: #d0d0d0;
      --past-text: #b5b5b5;
      --ease-signature: cubic-bezier(0.25, 0.46, 0.45, 0.94);

      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--foreground);
      height: 100vh;
      padding: 20px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      /* Le fond est peint par .grainient-bg, en dessous. */
      background: transparent;
      position: relative;
      z-index: 1;
    }

    /* Fond animé (dégradé grainé WebGL). Le canvas se glisse dedans ; la
       couleur unie du thème sert de repli si WebGL2 est indisponible. */
    .grainient-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      /* Valeurs en dur : ce bloc est frère de .routine-page, où sont
         déclarées les variables de palette — il n'en hérite donc pas. */
      background: #f4f0ec;
      pointer-events: none;
    }
    :global([data-theme='dark']) .grainient-bg {
      background: #0f1530;
    }

    :global(html),
    :global(body) {
      height: 100%;
      overflow: hidden;
      margin: 0;
    }

    :global([data-theme='dark']) .routine-page {
      --raisin: #e8e6ec;
      --cream: #0f1530;
      --white: #1a2040;
      --foreground: #e8e6ec;
      --isabelline: #2d3660;
      --polaroid-light: #1a2040;
      --polaroid-mid: #242c55;
      --cyan: #9ab2b6;
      --past-line: #3a4370;
      --past-text: #6a7398;
      background: var(--cream);
    }

    :global(html) {
      background: var(--cream, #f4f0ec);
    }

    .layout {
      flex: 1;
      min-height: 0;
      display: flex;
      gap: 20px;
      max-width: 1320px;
      width: 100%;
      margin: 0 auto;
    }
    .schedule-card {
      width: 340px;
      flex-shrink: 0;
      height: 100%;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }
    .tasks-card {
      flex: 1;
      min-width: 0;
      height: 100%;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .history-card {
      width: 260px;
      flex-shrink: 0;
      height: 100%;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }
    @media (max-width: 1024px) {
      .history-card {
        width: 220px;
      }
    }
    @media (max-width: 768px) {
      :global(html),
      :global(body) {
        overflow: auto;
      }
      .routine-page {
        height: auto;
        min-height: 100vh;
        overflow: visible;
      }
      .layout {
        flex-direction: column;
      }
      .schedule-card,
      .tasks-card,
      .history-card {
        width: auto;
        height: auto;
        overflow: visible;
      }
      .schedule-card,
      .tasks-card {
        margin-bottom: 20px;
      }
    }

    h1 {
      flex-shrink: 0;
      text-align: center;
      margin-bottom: 20px;
      font-size: 1.6em;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--raisin);
    }
    h1 span {
      background: linear-gradient(to bottom, transparent 60%, var(--sunglow) 60%);
      padding: 0 4px;
    }
    :global([data-theme='dark']) h1 span {
      background: linear-gradient(to bottom, transparent 60%, rgba(252, 202, 70, 0.35) 60%);
    }

    .card {
      background: var(--white);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(30, 41, 82, 0.08);
      border: 1px solid var(--isabelline);
      transition:
        box-shadow 0.3s var(--ease-signature),
        background 0.3s var(--ease-signature);
    }
    .card:hover {
      box-shadow: 0 6px 28px rgba(30, 41, 82, 0.12);
    }

    /* Schedule (timeline with thread + dot, matching the Moulin sidebar style) */
    .schedule-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--isabelline);
    }
    .schedule-title {
      font-size: 0.9em;
      font-weight: 700;
      color: var(--raisin);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .schedule-clock {
      font-size: 1em;
      font-weight: 700;
      color: var(--raisin);
      font-variant-numeric: tabular-nums;
    }

    .schedule-list {
      display: flex;
      flex-direction: column;
    }
    .schedule-item {
      display: flex;
      gap: 10px;
      padding: 9px 0 9px 28px;
      position: relative;
      align-items: center;
    }
    .schedule-item::before {
      content: '';
      position: absolute;
      left: 9px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--violet);
    }
    .schedule-item::after {
      content: '';
      position: absolute;
      left: 4px;
      top: 50%;
      transform: translateY(-50%);
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--violet);
      border: 2px solid var(--white);
      box-sizing: border-box;
      z-index: 1;
    }
    .schedule-item.past::before,
    .schedule-item.past::after {
      background: var(--past-line);
    }
    .schedule-item.past .schedule-time,
    .schedule-item.past .schedule-label {
      color: var(--past-text);
    }
    /* Le fil se remplit au fil du créneau : la césure passé/à-venir suit
       l'avancement réel dans le bloc plutôt qu'un 50/50 figé. */
    .schedule-item.current::before {
      background: linear-gradient(
        to bottom,
        var(--past-line) var(--block-progress, 50%),
        var(--violet) var(--block-progress, 50%)
      );
    }
    .schedule-item.current::after {
      background: var(--sunglow);
      box-shadow: 0 0 0 4px rgba(252, 202, 70, 0.25);
    }
    .schedule-item.current .schedule-time,
    .schedule-item.current .schedule-label {
      color: var(--sunglow);
      font-weight: 600;
    }
    .schedule-item:first-child::before {
      top: 50%;
    }
    .schedule-item:last-child::before {
      bottom: 50%;
    }
    .schedule-time {
      font-size: 0.88em;
      color: var(--cyan);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      min-width: 52px;
      letter-spacing: 0.02em;
      flex-shrink: 0;
    }
    .schedule-label {
      color: var(--raisin);
      font-size: 0.95em;
      line-height: 1.3;
      white-space: nowrap;
    }


    /* Sort controls */
    .sort-bar {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 4px;
    }
    .sort-label {
      font-size: 0.72em;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--cyan);
    }
    .sort-options {
      display: flex;
      gap: 4px;
    }
    .sort-btn {
      padding: 4px 11px;
      border: 2px solid var(--raisin);
      border-radius: 9999px;
      background: transparent;
      color: var(--raisin);
      font-family: 'Montserrat', sans-serif;
      font-size: 0.72em;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s var(--ease-signature);
    }
    .sort-btn:hover {
      background: var(--raisin);
      color: var(--sunglow);
    }
    .sort-btn.active {
      background: var(--sunglow);
      border-color: var(--sunglow);
      color: var(--raisin);
    }
    :global([data-theme='dark']) .sort-btn:hover {
      background: #1e2952;
      color: var(--sunglow);
    }

    /* Tasks */
    .tasks-section {
      flex-shrink: 0;
    }
    .tasks-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--isabelline);
    }
    .tasks-title {
      font-size: 0.9em;
      font-weight: 700;
      color: var(--raisin);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .tasks-count {
      font-size: 0.82em;
      color: var(--cyan);
      font-weight: 600;
    }
    .task-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    /* Entrée en cascade : au chargement, et à chaque fois qu'une liste change
       réellement lors du rafraîchissement (sinon rien n'est repeint).
       `backwards` (et non `both`) pour que le hover reprenne la main une fois
       l'animation terminée. */
    @keyframes taskIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes taskInDone {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 0.65;
        transform: none;
      }
    }
    .task-item {
      background: linear-gradient(165deg, var(--polaroid-light), var(--polaroid-mid));
      border: 1px solid var(--isabelline);
      border-left: 3px solid var(--isabelline);
      border-radius: 10px;
      padding: 10px 14px;
      transition:
        transform 0.2s var(--ease-signature),
        box-shadow 0.2s var(--ease-signature);
      animation: taskIn 0.28s var(--ease-signature) backwards;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    .task-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(30, 41, 82, 0.12);
    }
    @media (prefers-reduced-motion: reduce) {
      .task-item {
        transition: box-shadow 0.2s var(--ease-signature);
        animation: none;
      }
      .task-item:hover {
        transform: none;
      }
    }
    .task-item.in-progress {
      border-left-color: var(--sunglow);
    }
    .task-item.todo {
      border-left-color: var(--cyan);
    }
    .task-item.done {
      border-left-color: var(--violet);
      opacity: 0.65;
      animation-name: taskInDone;
    }
    .task-item a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--raisin);
      text-decoration: none;
    }
    .task-title {
      font-size: 0.92em;
      font-weight: 500;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .task-badge {
      flex-shrink: 0;
      font-size: 0.68em;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--badge-text);
      background: var(--badge-bg);
      border: 1px solid transparent;
      border-radius: 9999px;
      padding: 2px 9px;
    }
    :global([data-theme='dark']) .task-badge {
      color: var(--badge-text-dark);
      background: var(--badge-bg-dark);
    }
    .history-card .task-item .task-title {
      font-size: 0.85em;
    }
    .history-card .task-item.done .task-title {
      text-decoration: line-through;
      text-decoration-color: var(--past-line);
    }
    .tasks-empty {
      text-align: center;
      color: var(--cyan);
      font-size: 0.88em;
      opacity: 0.7;
      padding: 12px 0;
    }
    .tasks-error {
      color: #e94560;
      font-size: 0.85em;
    }

    /* Theme toggle */
    .theme-toggle-btn {
      position: fixed;
      right: 20px;
      top: 20px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid var(--raisin);
      background: var(--white);
      color: var(--raisin);
      font-size: 18px;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(30, 41, 82, 0.1);
      z-index: 45;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s var(--ease-signature);
    }
    .theme-toggle-btn:hover {
      background: var(--sunglow);
      border-color: var(--sunglow);
    }
    :global([data-theme='dark']) .theme-toggle-btn:hover {
      background: #1e2952;
      color: var(--sunglow);
    }
    .theme-toggle-btn.theme-auto {
      border-style: dashed;
    }

    @media (max-width: 480px) {
      .routine-page {
        padding: 12px;
      }
      h1 {
        font-size: 1.3em;
      }
      .card {
        padding: 16px;
      }
    }
  </style>
</Base>
