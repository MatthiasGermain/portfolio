---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import { getPlayerView } from '../../../lib/thomas-tcg/view';

const { id } = Astro.params;
const pid = id ?? '';
const { playerName, view } = await getPlayerView(pid);

if (view.kind === 'no-tournament') {
  return Astro.redirect('/thomas-tcg/setup');
}
if (view.kind === 'not-found') {
  return new Response('Joueur introuvable', { status: 404 });
}
---

<Base lang="fr" title={`Thomas TCG — ${playerName}`} description="Ton tour de jeu.">
  <main class="min-h-screen bg-ink px-4 py-8">
    <div class="max-w-2xl mx-auto space-y-5">
      <h1 class="text-xl font-semibold">{playerName}</h1>
      <div id="app"></div>
    </div>
  </main>

  <script define:vars={{ initialView: view, pid }}>
    const app = document.getElementById('app');
    let pollTimer = null;
    let selected = []; // instanceIds dans l'ordre de sélection

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    function stopPolling() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = null;
    }

    function startPolling(ms) {
      stopPolling();
      pollTimer = setInterval(poll, ms);
    }

    function renderSelect(view) {
      selected = [];
      app.innerHTML = `
        <p class="text-sm text-slate-400">${view.cardsLeft} carte(s) restante(s) dans ta main</p>
        ${view.opponentName ? `<div class="bg-surface border border-line rounded-lg p-3 text-center text-sm">Adversaire actuel : <strong>${escapeHtml(view.opponentName)}</strong></div>` : ''}
        <div class="bg-card border border-line rounded-xl p-5 mt-3">
          <h2 class="text-xs uppercase tracking-wide text-slate-400 mb-3">
            Choisis ${view.pickCount} carte${view.pickCount > 1 ? 's' : ''} (l'ordre compte : tu attaques dans cet ordre)
          </h2>
          <div id="hand" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
          <button id="confirm-btn" disabled class="w-full mt-4 py-2 rounded-lg bg-accent text-ink font-semibold opacity-40">
            Choisis ${view.pickCount} carte${view.pickCount > 1 ? 's' : ''}
          </button>
        </div>`;

      const hand = document.getElementById('hand');
      const btn = document.getElementById('confirm-btn');

      function renderHand() {
        hand.innerHTML = view.available
          .map((c) => {
            const order = selected.indexOf(c.instanceId);
            const isSel = order !== -1;
            const img = c.image ? `<img src="${c.image}" class="w-full aspect-[3/4] object-cover rounded-md mb-2" />` : '';
            return `
              <div data-instance="${c.instanceId}" class="relative cursor-pointer bg-surface border-2 ${isSel ? 'border-accent' : 'border-line'} rounded-lg p-2">
                ${isSel ? `<div class="absolute top-1 right-1 w-6 h-6 rounded-full bg-accent text-ink text-xs font-bold flex items-center justify-center">${order + 1}</div>` : ''}
                ${img}
                <div class="text-xs font-bold mb-1">${escapeHtml(c.title)}</div>
                <div class="flex gap-1">
                  <span class="flex-1 text-center text-[10px] rounded bg-rose-500/10 text-rose-400 py-1">${c.drip} drip</span>
                  <span class="flex-1 text-center text-[10px] rounded bg-emerald-500/10 text-emerald-400 py-1">${c.charisme} charisme</span>
                </div>
              </div>`;
          })
          .join('');

        hand.querySelectorAll('[data-instance]').forEach((el) => {
          el.addEventListener('click', () => {
            const instId = el.dataset.instance;
            const idx = selected.indexOf(instId);
            if (idx !== -1) {
              selected.splice(idx, 1);
            } else if (selected.length < view.pickCount) {
              selected.push(instId);
            }
            renderHand();
            const ready = selected.length === view.pickCount;
            btn.disabled = !ready;
            btn.classList.toggle('opacity-40', !ready);
            btn.textContent = ready
              ? 'Valider ma sélection'
              : `Choisis ${view.pickCount - selected.length} carte${view.pickCount - selected.length > 1 ? 's' : ''} de plus`;
          });
        });
      }
      renderHand();

      btn.addEventListener('click', async () => {
        btn.disabled = true;
        const fd = new FormData();
        fd.append('pid', pid);
        selected.forEach((instId) => fd.append('instance_id', instId));
        const res = await fetch('/api/thomas-tcg/select.json', { method: 'POST', body: fd });
        const data = await res.json();
        renderView(data.view);
      });
    }

    function renderView(view) {
      if (view.kind === 'finished') {
        stopPolling();
        app.innerHTML = view.isChampion
          ? `<div class="bg-card border border-line rounded-xl p-8 text-center"><p class="text-3xl font-extrabold text-accent">🏆 Tu es le champion !</p></div>`
          : `<div class="bg-card border border-line rounded-xl p-8 text-center">
               <p class="text-sm text-slate-400 mb-2">Tournoi terminé</p>
               <p class="text-lg">Champion : <strong>${escapeHtml(view.championName)}</strong></p>
             </div>`;
        return;
      }

      if (view.kind === 'not-your-turn') {
        app.innerHTML = `<div class="bg-surface border border-line rounded-lg p-4 text-center text-sm text-slate-400">En attente du prochain match.</div>`;
        startPolling(3000);
        return;
      }

      if (view.kind === 'waiting-opponent') {
        app.innerHTML = `
          ${view.opponentName ? `<div class="bg-surface border border-line rounded-lg p-3 text-center text-sm mb-3">Adversaire actuel : <strong>${escapeHtml(view.opponentName)}</strong></div>` : ''}
          <div class="bg-surface border border-line rounded-lg p-4 text-center text-sm text-slate-400">
            Cartes envoyées — en attente du choix de ton adversaire.
          </div>`;
        startPolling(1500);
        return;
      }

      if (view.kind === 'battle-in-progress') {
        stopPolling();
        app.innerHTML = `<div class="bg-surface border border-line rounded-lg p-4 text-center text-sm text-slate-400">Combat en cours — regarde l'écran principal !</div>`;
        return;
      }

      if (view.kind === 'select') {
        stopPolling();
        renderSelect(view);
        return;
      }
    }

    async function poll() {
      try {
        const res = await fetch(`/api/thomas-tcg/player-state.json?pid=${encodeURIComponent(pid)}`);
        const data = await res.json();
        renderView(data.view);
      } catch {
        // réseau indisponible : on garde l'affichage actuel
      }
    }

    renderView(initialView);
  </script>
</Base>
