---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getHostView } from '../../lib/thomas-tcg/view';

const view = await getHostView();

if (view.kind === 'no-tournament') {
  return Astro.redirect('/thomas-tcg/setup');
}
---

<Base lang="fr" title="Thomas TCG — Host" description="Écran principal du tournoi.">
  <style is:global>
    @keyframes ttcg-card-pop {
      from { opacity: 0; transform: scale(0.75) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .card-pop { animation: ttcg-card-pop 0.35s ease-out; }

    .flip-outer { perspective: 1000px; flex: 0 0 auto; }
    .flip-inner {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .flip-inner.is-flipped { transform: rotateY(180deg); }
    .flip-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .flip-back {
      background: linear-gradient(135deg, var(--color-card), var(--color-surface));
      border: 1px solid var(--color-line);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .flip-back span {
      font-family: var(--font-mono);
      font-size: 2.5rem;
      color: var(--color-accent);
      opacity: 0.5;
    }
    .flip-front {
      transform: rotateY(180deg);
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      display: flex;
      flex-direction: column;
    }
    .flip-front img { width: 100%; flex: 1 1 auto; min-height: 0; object-fit: cover; display: block; }
    .flip-front .flip-info { flex: 0 0 auto; }

    @keyframes ttcg-shake {
      10%, 90% { transform: translateX(-1px); }
      20%, 80% { transform: translateX(2px); }
      30%, 50%, 70% { transform: translateX(-4px); }
      40%, 60% { transform: translateX(4px); }
    }
    .shake { animation: ttcg-shake 0.4s; }

    @keyframes ttcg-float-up {
      0% { opacity: 0; transform: translateY(0) scale(0.8); }
      15% { opacity: 1; transform: translateY(-6px) scale(1.15); }
      100% { opacity: 0; transform: translateY(-38px) scale(1); }
    }
    .dmg-float {
      position: absolute;
      left: 50%;
      top: -4px;
      transform: translateX(-50%);
      font-weight: 800;
      font-size: 1.1rem;
      color: #fb7185;
      pointer-events: none;
      animation: ttcg-float-up 1s ease-out forwards;
      text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }
    .pv-wrap { position: relative; }

    @keyframes ttcg-confetti-fall {
      0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(320px) rotate(540deg); opacity: 0; }
    }
    .confetti-piece {
      position: absolute;
      top: 0;
      width: 8px;
      height: 14px;
      animation: ttcg-confetti-fall linear forwards;
    }
    .confetti-host { position: relative; overflow: hidden; }

    @keyframes ttcg-glow-pulse {
      0%, 100% { box-shadow: 0 0 0 rgba(255, 209, 102, 0); }
      50% { box-shadow: 0 0 24px rgba(255, 209, 102, 0.5); }
    }
    .glow-pulse { animation: ttcg-glow-pulse 1.4s ease-in-out infinite; }
  </style>

  <main class="min-h-screen bg-ink px-4 py-10">
    <div class="max-w-3xl mx-auto space-y-6">
      <div id="app"></div>

      <div class="bg-card border border-line rounded-xl p-6 overflow-x-auto">
        <h2 class="text-xs uppercase tracking-wide text-slate-400 mb-3">Bracket</h2>
        <div id="bracket" class="flex gap-5"></div>
      </div>
    </div>
  </main>

  <script define:vars={{ initialView: view }}>
    const app = document.getElementById('app');
    const bracketEl = document.getElementById('bracket');
    let pollTimer = null;

    // ---------- Son (synthétisé, aucun fichier externe) ----------
    let audioCtx = null;
    function actx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }
    function beep(freq, duration, type, vol, delay) {
      try {
        const c = actx();
        const osc = c.createOscillator();
        const gain = c.createGain();
        osc.type = type || 'sine';
        osc.frequency.value = freq;
        gain.gain.value = vol ?? 0.2;
        osc.connect(gain);
        gain.connect(c.destination);
        const t0 = c.currentTime + (delay || 0);
        osc.start(t0);
        gain.gain.exponentialRampToValueAtTime(0.001, t0 + duration);
        osc.stop(t0 + duration + 0.02);
      } catch {
        // Web Audio indisponible : silence, tant pis.
      }
    }
    function sfxFlip() { beep(700, 0.09, 'triangle', 0.12); }
    function sfxHit() {
      beep(130, 0.2, 'sawtooth', 0.22, 0);
      beep(70, 0.28, 'square', 0.15, 0.03);
    }
    function sfxWin() {
      [523, 659, 784, 1046].forEach((f, i) => beep(f, 0.3, 'triangle', 0.18, i * 0.13));
    }
    function sfxTie() {
      beep(300, 0.15, 'sine', 0.15, 0);
      beep(300, 0.15, 'sine', 0.15, 0.18);
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    let flipCounter = 0;
    function flipCardHtml(card, sizeClass) {
      const flipId = 'flip-' + ++flipCounter;
      const img = card.image ? `<img src="${card.image}" />` : '';
      return {
        id: flipId,
        html: `
          <div class="${sizeClass} flip-outer">
            <div class="flip-inner" id="${flipId}">
              <div class="flip-face flip-back"><span>?</span></div>
              <div class="flip-face flip-front">
                ${img}
                <div class="flip-info p-2 text-center">
                  <div class="font-bold text-sm">${escapeHtml(card.title)}</div>
                  <div class="flex justify-center gap-2 text-xs mt-1">
                    <span class="text-rose-400">${card.drip} drip</span>
                    <span class="text-emerald-400">${card.charisme} charisme</span>
                  </div>
                </div>
              </div>
            </div>
          </div>`,
      };
    }
    function triggerFlip(flipId) {
      setTimeout(() => {
        const el = document.getElementById(flipId);
        if (el) {
          el.classList.add('is-flipped');
          sfxFlip();
        }
      }, 30);
    }

    function pvBar(label, current, max, index) {
      const pct = max > 0 ? Math.max(0, Math.min(100, (current / max) * 100)) : 0;
      const color = pct > 50 ? 'bg-emerald-400' : pct > 20 ? 'bg-amber-400' : 'bg-rose-500';
      return `
        <div class="pv-wrap" id="pv-wrap-${index}">
          <div class="flex justify-between text-sm mb-1">
            <span class="font-bold">${escapeHtml(label)}</span>
            <span data-pv>${current} / ${max} PV</span>
          </div>
          <div class="h-3 rounded-full bg-surface border border-line overflow-hidden">
            <div class="h-full ${color} transition-all duration-700 ease-out" data-bar style="width:${pct}%"></div>
          </div>
        </div>`;
    }

    function spawnDamageFloat(index, amount) {
      const wrap = document.getElementById('pv-wrap-' + index);
      if (!wrap || amount <= 0) return;
      const el = document.createElement('div');
      el.className = 'dmg-float';
      el.textContent = '-' + amount;
      wrap.appendChild(el);
      wrap.classList.remove('shake');
      void wrap.offsetWidth;
      wrap.classList.add('shake');
      setTimeout(() => el.remove(), 1000);
    }

    function renderBracket(bracket) {
      bracketEl.innerHTML = bracket
        .map(
          (roundView) => `
        <div class="flex flex-col justify-around gap-3 min-w-[160px]">
          ${roundView
            .map(
              (m) => `
            <div class="bg-surface border border-line rounded-lg px-3 py-2 text-xs">
              <div class="${m.winner && m.winner === m.a ? 'text-accent font-bold' : ''}">${escapeHtml(m.a ?? '?')}</div>
              <div class="${m.winner && m.winner === m.b ? 'text-accent font-bold' : ''}">${escapeHtml(m.b ?? '?')}</div>
              ${m.isBye ? '<div class="text-slate-500 italic">bye</div>' : ''}
            </div>`,
            )
            .join('')}
        </div>`,
        )
        .join('');
    }

    function spawnConfetti(container) {
      const colors = ['#ffd166', '#34d399', '#fb7185', '#60a5fa', '#c084fc'];
      container.classList.add('confetti-host');
      for (let i = 0; i < 60; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.left = Math.random() * 100 + '%';
        piece.style.background = colors[i % colors.length];
        piece.style.animationDuration = 1.2 + Math.random() * 1.2 + 's';
        piece.style.animationDelay = Math.random() * 0.4 + 's';
        piece.style.transform = `rotate(${Math.random() * 360}deg)`;
        container.appendChild(piece);
        setTimeout(() => piece.remove(), 3000);
      }
    }

    async function postJson(url) {
      const res = await fetch(url, { method: 'POST' });
      return res.json();
    }

    function stopPolling() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = null;
    }

    function startPolling(fn, ms) {
      stopPolling();
      pollTimer = setInterval(fn, ms);
    }

    async function renderView(view) {
      renderBracket(view.bracket ?? []);

      if (view.kind === 'finished') {
        stopPolling();
        app.innerHTML = `
          <div id="champion-box" class="bg-card border border-line rounded-xl p-8 text-center glow-pulse">
            <p class="text-sm text-slate-400 mb-2">🏆 Champion</p>
            <p class="text-4xl font-extrabold text-accent mb-6">${escapeHtml(view.championName)}</p>
            <button id="reset-btn" class="px-4 py-2 rounded-lg bg-surface border border-line text-slate-100">Nouveau tournoi</button>
          </div>`;
        sfxWin();
        spawnConfetti(document.getElementById('champion-box'));
        document.getElementById('reset-btn')?.addEventListener('click', async () => {
          await postJson('/api/thomas-tcg/reset.json');
          location.href = '/thomas-tcg/setup';
        });
        return;
      }

      if (view.kind === 'no-active-match') {
        app.innerHTML = `<div class="bg-card border border-line rounded-xl p-6 text-center text-slate-400">En attente du prochain match du bracket...</div>`;
        startPolling(poll, 2000);
        return;
      }

      if (view.kind === 'selecting') {
        app.innerHTML = `
          <div>
            <h1 class="text-xl font-semibold">Thomas TCG — Sélection des cartes</h1>
            <p class="text-sm text-slate-400">
              ${view.isTieBreak ? 'Égalité — une carte de plus chacun' : 'Chaque joueur choisit ses 3 cartes'} —
              <a href="/thomas-tcg/players" class="text-accent underline">liens joueurs</a>
            </p>
          </div>
          <div class="flex items-center gap-4 mt-4">
            <div class="flex-1 bg-surface border border-line rounded-xl p-5 text-center">
              <div class="text-lg font-bold">${escapeHtml(view.playerAName)}</div>
              <div class="text-xs text-slate-400 mt-1">${view.aReady ? '✔ prêt' : 'en train de choisir...'}</div>
            </div>
            <div class="text-slate-400 font-bold">VS</div>
            <div class="flex-1 bg-surface border border-line rounded-xl p-5 text-center">
              <div class="text-lg font-bold">${escapeHtml(view.playerBName)}</div>
              <div class="text-xs text-slate-400 mt-1">${view.bReady ? '✔ prêt' : 'en train de choisir...'}</div>
            </div>
          </div>`;
        startPolling(poll, 1500);
        return;
      }

      if (view.kind === 'battle') {
        stopPolling();
        app.innerHTML = `
          <div>
            <h1 class="text-xl font-semibold">Thomas TCG — Combat</h1>
            <p class="text-sm text-slate-400">Manche ${Math.min(view.revealedCount + 1, view.targetLength)} / ${view.targetLength}</p>
          </div>
          <div class="grid grid-cols-2 gap-4 mt-4">
            ${pvBar(view.playerAName, view.currentPvA, view.maxPvA, 0)}
            ${pvBar(view.playerBName, view.currentPvB, view.maxPvB, 1)}
          </div>
          <div id="battle-stage" class="bg-card border border-line rounded-xl p-6 mt-4 min-h-[220px] flex items-center justify-center gap-6"></div>
          <div class="mt-4">
            <button id="battle-btn" class="w-full py-2 rounded-lg bg-accent text-ink font-semibold"></button>
          </div>`;

        const stage = document.getElementById('battle-stage');
        const btn = document.getElementById('battle-btn');

        if (view.revealSub === 1 && view.revealedACard) {
          const flip = flipCardHtml(view.revealedACard, 'w-40');
          stage.innerHTML = flip.html + `<div class="text-slate-500 text-2xl">VS ?</div>`;
          triggerFlip(flip.id);
          btn.textContent = `Révéler la carte de ${view.playerBName}`;
        } else if (view.canResolve) {
          stage.innerHTML = `<p class="text-slate-400">Toutes les cartes sont révélées.</p>`;
          btn.textContent = 'Voir le résultat';
        } else {
          stage.innerHTML = `<p class="text-slate-400">Prêt pour la prochaine carte.</p>`;
          btn.textContent = `Révéler la carte de ${view.playerAName}`;
        }

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          if (view.canResolve) {
            const data = await postJson('/api/thomas-tcg/resolve.json');
            if (data.result === 'tie') {
              sfxTie();
              stage.innerHTML = `<p class="text-amber-400 font-semibold">Égalité de PV — une carte de plus chacun !</p>`;
              setTimeout(poll, 1200);
            } else {
              stage.innerHTML = `<p class="text-accent text-xl font-bold">Vainqueur du duel : ${escapeHtml(data.winnerName)}</p>`;
              setTimeout(poll, 1800);
            }
            return;
          }

          const data = await postJson('/api/thomas-tcg/reveal-next.json');
          if (data.step === 'reveal-a') {
            const flip = flipCardHtml(data.card, 'w-40');
            stage.innerHTML = flip.html + `<div class="text-slate-500 text-2xl">VS ?</div>`;
            triggerFlip(flip.id);
            btn.textContent = `Révéler la carte de ${view.playerBName}`;
            btn.disabled = false;
          } else if (data.step === 'reveal-b') {
            const aFlipHtml = stage.querySelector('.flip-outer')?.outerHTML ?? '';
            const flipB = flipCardHtml(data.card, 'w-40');
            stage.innerHTML = aFlipHtml + `<div class="text-slate-500 text-2xl">VS</div>` + flipB.html;
            triggerFlip(flipB.id);

            const dmgToA = Math.max(0, view.currentPvA - data.newPvA);
            const dmgToB = Math.max(0, view.currentPvB - data.newPvB);
            setTimeout(() => {
              sfxHit();
              animatePv(data.newPvA, view.maxPvA, 0);
              animatePv(data.newPvB, view.maxPvB, 1);
              spawnDamageFloat(0, dmgToA);
              spawnDamageFloat(1, dmgToB);
            }, 600);

            setTimeout(() => poll(), 1700);
          }
        });
        return;
      }
    }

    function animatePv(to, max, index) {
      const bar = document.querySelectorAll('[data-bar]')[index];
      const val = document.querySelectorAll('[data-pv]')[index];
      if (!bar || !val) return;
      const pct = max > 0 ? Math.max(0, Math.min(100, (to / max) * 100)) : 0;
      bar.style.width = pct + '%';
      val.textContent = `${to} / ${max} PV`;
    }

    let lastSignature = '';
    async function poll() {
      try {
        const res = await fetch('/api/thomas-tcg/host-state.json');
        const view = await res.json();
        const sig = JSON.stringify(view);
        if (sig === lastSignature) return;
        lastSignature = sig;
        renderView(view);
      } catch {
        // réseau indisponible : on garde l'affichage actuel
      }
    }

    lastSignature = JSON.stringify(initialView);
    renderView(initialView);
  </script>
</Base>
