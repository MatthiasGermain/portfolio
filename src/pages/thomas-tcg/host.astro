---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getHostView } from '../../lib/thomas-tcg/view';

const view = await getHostView();

if (view.kind === 'no-tournament') {
  return Astro.redirect('/thomas-tcg/setup');
}
---

<Base lang="fr" title="Thomas TCG — Host" description="Écran principal du tournoi.">
  <style is:global>
    @keyframes ttcg-card-pop {
      from { opacity: 0; transform: scale(0.75) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .card-pop { animation: ttcg-card-pop 0.35s ease-out; }

    .flip-outer { perspective: 1000px; flex: 0 0 auto; }
    .flip-inner {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .flip-inner.is-flipped { transform: rotateY(180deg); }
    .flip-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .flip-back {
      background: linear-gradient(135deg, var(--color-card), var(--color-surface));
      border: 1px solid var(--color-line);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .flip-back span {
      font-family: var(--font-mono);
      font-size: 2.5rem;
      color: var(--color-accent);
      opacity: 0.5;
    }
    .flip-front {
      transform: rotateY(180deg);
      background: var(--color-surface);
      border: 1px solid var(--color-line);
    }

    /* Taille des cartes : grandes, mais bornées par la hauteur de l'écran pour
       que la carte gagnante agrandie tienne sans défiler. */
    :root {
      --card-w: clamp(200px, min(26vw, calc((100vh - 380px) * 0.75)), 380px);
      --winner-w: clamp(260px, min(40vw, calc((100vh - 300px) * 0.75)), 520px);
    }
    .card-lg { width: var(--card-w); }
    .card-winner { width: var(--winner-w); }
    .duel-stage { min-height: calc(var(--winner-w) * 4 / 3 + 3rem); }

    /* Les images ont des formats très variés (de 0,35 à 2,2) : on les montre
       entières (`contain`) sur un fond flouté tiré de la même image, plutôt
       que de les rogner. Titre et stats en bandeau par-dessus. */
    .card-art-bg {
      position: absolute;
      inset: -24px;
      background-size: cover;
      background-position: center;
      filter: blur(20px) brightness(0.5);
    }
    .card-art {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .card-info {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 1.25rem 0.75rem 0.7rem;
      text-align: center;
      background: linear-gradient(to top, rgba(5, 7, 9, 0.92), rgba(5, 7, 9, 0.6) 65%, transparent);
    }
    .card-info.no-art {
      top: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: none;
    }

    /* Fin de manche : la perdante s'efface, la gagnante passe au centre en grand. */
    .duel-out {
      opacity: 0;
      transform: scale(0.85);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .winner-glow {
      box-shadow: 0 0 0 3px rgba(255, 209, 102, 0.9), 0 0 48px rgba(255, 209, 102, 0.55);
      transition: box-shadow 0.4s ease;
    }
    .duel-tie .flip-front {
      box-shadow: 0 0 0 2px rgba(148, 163, 184, 0.8);
    }
    @media (prefers-reduced-motion: reduce) {
      .duel-out { transition-duration: 0.01ms; }
    }

    /* Tableau de score : manches gagnées, une pastille par manche. */
    .score-num {
      font-variant-numeric: tabular-nums;
      display: inline-block;
    }
    @keyframes ttcg-score-pop {
      0% { transform: scale(1); }
      40% { transform: scale(1.6); }
      100% { transform: scale(1); }
    }
    .score-pop { animation: ttcg-score-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .pip {
      width: 1.1rem;
      height: 1.1rem;
      border-radius: 9999px;
      border: 2px solid var(--color-line);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    .pip-a { background: #38bdf8; border-color: #38bdf8; }
    .pip-b { background: #fb7185; border-color: #fb7185; }
    .pip-draw { background: #64748b; border-color: #64748b; }
    .side-a { color: #38bdf8; }
    .side-b { color: #fb7185; }
    @media (prefers-reduced-motion: reduce) {
      .score-pop { animation: none; }
    }

    @keyframes ttcg-confetti-fall {
      0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(320px) rotate(540deg); opacity: 0; }
    }
    .confetti-piece {
      position: absolute;
      top: 0;
      width: 8px;
      height: 14px;
      animation: ttcg-confetti-fall linear forwards;
    }
    .confetti-host { position: relative; overflow: hidden; }

    @keyframes ttcg-glow-pulse {
      0%, 100% { box-shadow: 0 0 0 rgba(255, 209, 102, 0); }
      50% { box-shadow: 0 0 24px rgba(255, 209, 102, 0.5); }
    }
    .glow-pulse { animation: ttcg-glow-pulse 1.4s ease-in-out infinite; }
  </style>

  <main class="min-h-screen bg-ink px-4 py-10">
    <div class="max-w-6xl mx-auto space-y-6">
      <div id="app"></div>

      <div class="bg-card border border-line rounded-xl p-6 overflow-x-auto">
        <h2 class="text-xs uppercase tracking-wide text-slate-400 mb-3">Bracket</h2>
        <div id="bracket" class="flex gap-5"></div>
      </div>
    </div>
  </main>

  <script define:vars={{ initialView: view }}>
    const app = document.getElementById('app');
    const bracketEl = document.getElementById('bracket');
    let pollTimer = null;

    // ---------- Son (synthétisé, aucun fichier externe) ----------
    let audioCtx = null;
    function actx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }
    function beep(freq, duration, type, vol, delay) {
      try {
        const c = actx();
        const osc = c.createOscillator();
        const gain = c.createGain();
        osc.type = type || 'sine';
        osc.frequency.value = freq;
        gain.gain.value = vol ?? 0.2;
        osc.connect(gain);
        gain.connect(c.destination);
        const t0 = c.currentTime + (delay || 0);
        osc.start(t0);
        gain.gain.exponentialRampToValueAtTime(0.001, t0 + duration);
        osc.stop(t0 + duration + 0.02);
      } catch {
        // Web Audio indisponible : silence, tant pis.
      }
    }
    function sfxFlip() { beep(700, 0.09, 'triangle', 0.12); }
    function sfxWin() {
      [523, 659, 784, 1046].forEach((f, i) => beep(f, 0.3, 'triangle', 0.18, i * 0.13));
    }
    function sfxTie() {
      beep(300, 0.15, 'sine', 0.15, 0);
      beep(300, 0.15, 'sine', 0.15, 0.18);
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    let flipCounter = 0;
    function flipCardHtml(card, sizeClass) {
      const flipId = 'flip-' + ++flipCounter;
      const src = card.image ? encodeURI(card.image).replace(/'/g, '%27') : null;
      const art = src
        ? `<div class="card-art-bg" style="background-image:url('${src}')"></div><img class="card-art" src="${src}" alt="" />`
        : '';
      // Puissance de la carte (charisme + drip) : la plus puissante remporte la
      // manche, même règle que `roundResult` côté serveur.
      const power = card.charisme + card.drip;
      return {
        id: flipId,
        html: `
          <div class="${sizeClass} flip-outer" data-power="${power}">
            <div class="flip-inner" id="${flipId}">
              <div class="flip-face flip-back"><span>?</span></div>
              <div class="flip-face flip-front">
                ${art}
                <div class="card-info ${src ? '' : 'no-art'}">
                  <div class="font-bold text-lg leading-tight">${escapeHtml(card.title)}</div>
                  <div class="text-accent text-2xl font-extrabold leading-tight">Puissance ${power}</div>
                  <div class="flex justify-center gap-3 text-sm mt-1">
                    <span class="text-rose-400">${card.drip} drip</span>
                    <span class="text-emerald-400">${card.charisme} charisme</span>
                  </div>
                </div>
              </div>
            </div>
          </div>`,
      };
    }

    // Durées de la fin de manche (ms).
    const DUEL = { scoreAt: 650, spotlightAt: 1500, fadeOut: 400, grow: 500, hold: 1000 };
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function sfxRoundWin() {
      beep(660, 0.14, 'triangle', 0.14, 0);
      beep(990, 0.22, 'triangle', 0.14, 0.12);
    }

    /**
     * Met en avant la carte gagnante de la manche : la perdante et le "VS"
     * s'effacent, puis la gagnante glisse au centre en grandissant (technique
     * FLIP : on mesure sa position avant et après le changement de mise en
     * page, puis on anime l'écart pour que le déplacement soit continu).
     */
    function spotlightRoundWinner(stage) {
      const cards = stage.querySelectorAll('.flip-outer');
      if (cards.length !== 2) return;
      const [a, b] = cards;
      const powerA = Number(a.dataset.power);
      const powerB = Number(b.dataset.power);
      const vs = stage.querySelector('.duel-vs');

      if (powerA === powerB) {
        if (vs) vs.textContent = 'Égalité';
        stage.classList.add('duel-tie');
        return;
      }

      const winner = powerA > powerB ? a : b;
      const loser = powerA > powerB ? b : a;
      loser.classList.add('duel-out');
      vs?.classList.add('duel-out');

      setTimeout(() => {
        const first = winner.getBoundingClientRect();
        loser.style.display = 'none';
        if (vs) vs.style.display = 'none';
        winner.classList.remove('card-lg');
        winner.classList.add('card-winner');
        const last = winner.getBoundingClientRect();

        winner.querySelector('.flip-front')?.classList.add('winner-glow');
        sfxRoundWin();
        if (reducedMotion || !last.width) return;

        winner.style.transformOrigin = 'top left';
        winner.style.transition = 'none';
        winner.style.transform = `translate(${first.left - last.left}px, ${first.top - last.top}px) scale(${first.width / last.width})`;
        void winner.offsetWidth;
        winner.style.transition = `transform ${DUEL.grow}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        winner.style.transform = '';
      }, DUEL.fadeOut);
    }
    function triggerFlip(flipId) {
      setTimeout(() => {
        const el = document.getElementById(flipId);
        if (el) {
          el.classList.add('is-flipped');
          sfxFlip();
        }
      }, 30);
    }

    /** Une pastille par manche prévue, colorée selon qui l'a gagnée. */
    function pipsHtml(rounds, targetLength) {
      return Array.from({ length: targetLength }, (_, i) => {
        const r = rounds[i];
        const cls = r === 'a' ? 'pip-a' : r === 'b' ? 'pip-b' : r === 'draw' ? 'pip-draw' : '';
        return `<span class="pip ${cls}" data-pip="${i}" title="Manche ${i + 1}"></span>`;
      }).join('');
    }

    function scoreboardHtml(view) {
      return `
        <div class="bg-card border border-line rounded-xl px-6 py-4 mt-4 flex items-center justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="text-2xl font-extrabold truncate side-a">${escapeHtml(view.playerAName)}</div>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="text-5xl font-extrabold leading-none">
              <span class="score-num side-a" id="score-a">${view.winsA}</span>
              <span class="text-slate-500 mx-2">–</span>
              <span class="score-num side-b" id="score-b">${view.winsB}</span>
            </div>
            <div class="flex gap-2" id="pips">${pipsHtml(view.rounds, view.targetLength)}</div>
          </div>
          <div class="flex-1 min-w-0 text-right">
            <div class="text-2xl font-extrabold truncate side-b">${escapeHtml(view.playerBName)}</div>
          </div>
        </div>`;
    }

    /** Met à jour le score après une manche, avec un petit rebond du chiffre qui bouge. */
    function updateScore(data) {
      const scoreA = document.getElementById('score-a');
      const scoreB = document.getElementById('score-b');
      if (scoreA) scoreA.textContent = data.winsA;
      if (scoreB) scoreB.textContent = data.winsB;
      const pip = document.querySelector(`[data-pip="${data.roundIndex}"]`);
      if (pip) pip.classList.add(data.roundWinner === 'a' ? 'pip-a' : data.roundWinner === 'b' ? 'pip-b' : 'pip-draw');
      const moved = data.roundWinner === 'a' ? scoreA : data.roundWinner === 'b' ? scoreB : null;
      if (moved) {
        moved.classList.remove('score-pop');
        void moved.offsetWidth;
        moved.classList.add('score-pop');
      }
    }

    /** Bracket lisible de loin : nom des tours, match en cours surligné, scores. */
    function renderBracket(bracket) {
      bracketEl.innerHTML = bracket
        .map(
          (round) => `
        <div class="flex flex-col gap-3 min-w-[210px]">
          <div class="text-xs uppercase tracking-wide text-slate-400 font-semibold">${escapeHtml(round.label)}</div>
          <div class="flex flex-col justify-around gap-3 flex-1">
          ${round.matches
            .map((m) => {
              const border = m.isActive ? 'border-accent ring-2 ring-accent/40' : 'border-line';
              const line = (name) => {
                if (m.isBye && !name) return '';
                const won = m.winner && m.winner === name;
                const lost = m.winner && name && m.winner !== name;
                return `<div class="truncate ${won ? 'text-accent font-bold' : lost ? 'text-slate-500' : ''}">${escapeHtml(name ?? '…')}</div>`;
              };
              return `
            <div class="bg-surface border ${border} rounded-lg px-3 py-2 text-base">
              ${m.isActive ? '<div class="text-[10px] uppercase tracking-wide text-accent font-bold mb-1">En cours</div>' : ''}
              ${line(m.a)}
              ${line(m.b)}
              ${m.isBye ? '<div class="text-xs text-slate-500 italic">exempt</div>' : ''}
              ${m.score ? `<div class="text-xs text-slate-400 mt-1">${escapeHtml(m.score)}</div>` : ''}
            </div>`;
            })
            .join('')}
          </div>
        </div>`,
        )
        .join('');
    }

    function cardThumbHtml(card) {
      if (!card) return '';
      const src = card.image ? encodeURI(card.image).replace(/'/g, '%27') : null;
      return src
        ? `<img src="${src}" alt="" class="w-full h-40 object-contain rounded-lg bg-surface mb-2" />`
        : '';
    }

    /** Podium et faits marquants du tournoi terminé. */
    function finishedHtml(view) {
      const { podium, stats } = view;
      const step = (place, names, height, medal) =>
        names.length
          ? `<div class="flex-1 flex flex-col items-center justify-end">
               <div class="text-lg font-bold text-center mb-2">${names.map(escapeHtml).join('<br>')}</div>
               <div class="w-full ${height} rounded-t-xl bg-surface border border-line flex flex-col items-center justify-start pt-3">
                 <div class="text-3xl">${medal}</div>
                 <div class="text-sm text-slate-400">${place}</div>
               </div>
             </div>`
          : '<div class="flex-1"></div>';

      const statCard = (title, body) => `
        <div class="bg-surface border border-line rounded-xl p-4">
          <div class="text-xs uppercase tracking-wide text-slate-400 mb-2">${title}</div>
          ${body}
        </div>`;

      const statsHtml = [
        stats.mostPlayedCard &&
          statCard(
            'Carte la plus jouée',
            `${cardThumbHtml(stats.mostPlayedCard)}<div class="font-bold">${escapeHtml(stats.mostPlayedCard.title)}</div>
             <div class="text-sm text-slate-400">${stats.mostPlayedCard.count} manche${stats.mostPlayedCard.count > 1 ? 's' : ''}</div>`,
          ),
        stats.biggestWin &&
          statCard(
            'Plus grosse victoire de manche',
            `${cardThumbHtml(stats.biggestWin.winnerCard)}
             <div class="font-bold">${escapeHtml(stats.biggestWin.winnerCard.title)}</div>
             <div class="text-sm text-slate-400">${escapeHtml(stats.biggestWin.winnerName)} écrase « ${escapeHtml(stats.biggestWin.loserCard.title)} »
               de ${escapeHtml(stats.biggestWin.loserName)} : ${stats.biggestWin.winnerPower} contre ${stats.biggestWin.loserPower}</div>`,
          ),
        stats.longestMatch &&
          statCard(
            'Match le plus disputé',
            `<div class="font-bold">${escapeHtml(stats.longestMatch.aName)} vs ${escapeHtml(stats.longestMatch.bName)}</div>
             <div class="text-sm text-slate-400">${stats.longestMatch.rounds} manches</div>`,
          ),
      ]
        .filter(Boolean)
        .join('');

      return `
        <div id="champion-box" class="bg-card border border-line rounded-xl p-8 glow-pulse">
          <div class="flex items-center justify-between mb-6">
            <h1 class="text-xl font-semibold">Thomas TCG — Tournoi terminé</h1>
            <a href="/thomas-tcg/regles" class="text-sm text-accent underline">Règles</a>
          </div>
          <div class="flex items-end gap-4 max-w-3xl mx-auto">
            ${step('2e', podium.second ? [podium.second] : [], 'h-28', '🥈')}
            ${step('Champion', podium.first ? [podium.first] : [], 'h-40', '🏆')}
            ${step('3e', podium.thirds, 'h-20', '🥉')}
          </div>
          ${statsHtml ? `<div class="grid gap-4 sm:grid-cols-3 mt-8">${statsHtml}</div>` : ''}
          <div class="text-center mt-8">
            <button id="reset-btn" class="px-4 py-2 rounded-lg bg-surface border border-line text-slate-100">Nouveau tournoi</button>
          </div>
        </div>`;
    }

    function spawnConfetti(container) {
      const colors = ['#ffd166', '#34d399', '#fb7185', '#60a5fa', '#c084fc'];
      container.classList.add('confetti-host');
      for (let i = 0; i < 60; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.left = Math.random() * 100 + '%';
        piece.style.background = colors[i % colors.length];
        piece.style.animationDuration = 1.2 + Math.random() * 1.2 + 's';
        piece.style.animationDelay = Math.random() * 0.4 + 's';
        piece.style.transform = `rotate(${Math.random() * 360}deg)`;
        container.appendChild(piece);
        setTimeout(() => piece.remove(), 3000);
      }
    }

    async function postJson(url) {
      const res = await fetch(url, { method: 'POST' });
      return res.json();
    }

    function stopPolling() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = null;
    }

    function startPolling(fn, ms) {
      stopPolling();
      pollTimer = setInterval(fn, ms);
    }

    async function renderView(view) {
      renderBracket(view.bracket ?? []);

      if (view.kind === 'finished') {
        stopPolling();
        app.innerHTML = finishedHtml(view);
        sfxWin();
        spawnConfetti(document.getElementById('champion-box'));
        document.getElementById('reset-btn')?.addEventListener('click', async () => {
          await postJson('/api/thomas-tcg/reset.json');
          location.href = '/thomas-tcg/setup';
        });
        return;
      }

      if (view.kind === 'no-active-match') {
        app.innerHTML = `<div class="bg-card border border-line rounded-xl p-6 text-center text-slate-400">En attente du prochain match du bracket...</div>`;
        startPolling(poll, 2000);
        return;
      }

      if (view.kind === 'selecting') {
        app.innerHTML = `
          <div>
            <h1 class="text-xl font-semibold">Thomas TCG — Sélection des cartes</h1>
            <p class="text-sm text-slate-400">
              ${view.isTieBreak ? 'Égalité — manche décisive : une carte de plus chacun' : 'Chaque joueur choisit ses 3 cartes, dans l\'ordre des manches'} —
              <a href="/thomas-tcg/players" class="text-accent underline">liens joueurs</a> ·
              <a href="/thomas-tcg/regles" class="text-accent underline">règles</a>
            </p>
          </div>
          <div class="flex items-center gap-4 mt-4">
            <div class="flex-1 bg-surface border border-line rounded-xl p-5 text-center">
              <div class="text-lg font-bold">${escapeHtml(view.playerAName)}</div>
              <div class="text-xs text-slate-400 mt-1">${view.aReady ? '✔ prêt' : 'en train de choisir...'}</div>
            </div>
            <div class="text-slate-400 font-bold">VS</div>
            <div class="flex-1 bg-surface border border-line rounded-xl p-5 text-center">
              <div class="text-lg font-bold">${escapeHtml(view.playerBName)}</div>
              <div class="text-xs text-slate-400 mt-1">${view.bReady ? '✔ prêt' : 'en train de choisir...'}</div>
            </div>
          </div>`;
        startPolling(poll, 1500);
        return;
      }

      if (view.kind === 'battle') {
        stopPolling();
        const roundNumber = Math.min(view.revealedCount + 1, view.targetLength);
        app.innerHTML = `
          <div class="flex items-baseline justify-between gap-4">
            <div>
              <h1 class="text-xl font-semibold">Thomas TCG — Combat</h1>
              <p class="text-sm text-slate-400">
                ${view.isTieBreak ? 'Manche décisive' : `Manche ${roundNumber} sur ${view.targetLength}`} — meilleur des 3 manches
              </p>
            </div>
            <a href="/thomas-tcg/regles" class="text-sm text-accent underline">Règles</a>
          </div>
          ${scoreboardHtml(view)}
          <div id="battle-stage" class="duel-stage bg-card border border-line rounded-xl p-6 mt-4 flex items-center justify-center gap-8"></div>
          <div class="mt-4">
            <button id="battle-btn" class="w-full py-3 rounded-lg bg-accent text-ink font-semibold text-lg"></button>
          </div>`;

        const stage = document.getElementById('battle-stage');
        const btn = document.getElementById('battle-btn');

        if (view.revealSub === 1 && view.revealedACard) {
          const flip = flipCardHtml(view.revealedACard, 'card-lg');
          stage.innerHTML = flip.html + `<div class="duel-vs text-slate-500 text-4xl font-bold">VS ?</div>`;
          triggerFlip(flip.id);
          btn.textContent = `Révéler la carte de ${view.playerBName}`;
        } else if (view.canResolve) {
          const leader = view.winsA > view.winsB ? view.playerAName : view.playerBName;
          stage.innerHTML = view.decidedEarly
            ? `<p class="text-2xl font-bold text-center">Match plié : ${escapeHtml(leader)} mène ${view.winsA} – ${view.winsB}<br>
                 <span class="text-base font-normal text-slate-400">La dernière carte n'a pas besoin d'être révélée.</span></p>`
            : `<p class="text-2xl text-slate-300 text-center">Toutes les manches sont jouées.</p>`;
          btn.textContent = 'Voir le résultat';
        } else {
          stage.innerHTML = `<p class="text-2xl text-slate-400">Prêt pour la manche ${roundNumber}.</p>`;
          btn.textContent = `Révéler la carte de ${view.playerAName}`;
        }

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          if (view.canResolve) {
            const data = await postJson('/api/thomas-tcg/resolve.json');
            if (data.result === 'tie') {
              sfxTie();
              stage.innerHTML = `<p class="text-amber-400 text-3xl font-bold text-center">Égalité !<br>
                <span class="text-lg font-semibold">Manche décisive : chacun ajoute une carte</span></p>`;
              setTimeout(poll, 1600);
            } else {
              sfxWin();
              stage.innerHTML = `<p class="text-accent text-4xl font-extrabold text-center">${escapeHtml(data.winnerName)}<br>
                <span class="text-xl font-semibold text-slate-300">remporte le match ${Math.max(data.winsA, data.winsB)} – ${Math.min(data.winsA, data.winsB)}</span></p>`;
              setTimeout(poll, 2200);
            }
            return;
          }

          const data = await postJson('/api/thomas-tcg/reveal-next.json');
          if (data.step === 'reveal-a') {
            const flip = flipCardHtml(data.card, 'card-lg');
            stage.innerHTML = flip.html + `<div class="duel-vs text-slate-500 text-4xl font-bold">VS ?</div>`;
            triggerFlip(flip.id);
            btn.textContent = `Révéler la carte de ${view.playerBName}`;
            btn.disabled = false;
          } else if (data.step === 'reveal-b') {
            const aFlipHtml = stage.querySelector('.flip-outer')?.outerHTML ?? '';
            const flipB = flipCardHtml(data.card, 'card-lg');
            stage.innerHTML = aFlipHtml + `<div class="duel-vs text-slate-500 text-4xl font-bold">VS</div>` + flipB.html;
            triggerFlip(flipB.id);

            setTimeout(() => updateScore(data), DUEL.scoreAt);

            setTimeout(() => spotlightRoundWinner(stage), DUEL.spotlightAt);

            // Manche suivante une fois la gagnante restée affichée `hold` ms.
            setTimeout(() => poll(), DUEL.spotlightAt + DUEL.fadeOut + DUEL.grow + DUEL.hold);
          }
        });
        return;
      }
    }

    let lastSignature = '';
    async function poll() {
      try {
        const res = await fetch('/api/thomas-tcg/host-state.json');
        const view = await res.json();
        const sig = JSON.stringify(view);
        if (sig === lastSignature) return;
        lastSignature = sig;
        renderView(view);
      } catch {
        // réseau indisponible : on garde l'affichage actuel
      }
    }

    lastSignature = JSON.stringify(initialView);
    renderView(initialView);
  </script>
</Base>
